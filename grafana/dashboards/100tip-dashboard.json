{
  "title": "🏆 100TIP Enterprise Monitoring",
  "tags": ["100tip", "go", "microservices"],
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "title": "🌐 Global Traffic Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(rate(gin_requests_total[1m]))", "legendFormat": "Req/s" }],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
{
      "title": "🔐 จำนวนการ Login สำเร็จ (Total Logins)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "targets": [
        { 
          "expr": "sum(gin_requests_total{url=\"/api/auth/login\", code=\"200\"})", 
          "legendFormat": "Successful Logins" 
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "🛡️ Circuit Breaker (Discussion -> Auth)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "targets": [
        { "expr": "auth_breaker_state", "legendFormat": "State" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "CLOSED (🟢 ปกติ)", "color": "green" },
                "1": { "text": "HALF-OPEN (🟡 ลองต่อใหม่)", "color": "yellow" },
                "2": { "text": "OPEN (🔴 ตัดไฟ!)", "color": "red" }
                
              }
            }
          ]
        }
      }
    },
    {
      "title": "Discussion: Post Creation Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [{ "expr": "rate(gin_requests_total{instance=~\"discussion-service.*\", method=\"POST\", url=\"/api/posts\"}[1m])", "legendFormat": "New Posts/min" }]
    },
    {
      "title": "💻 System Resources (Go Runtime)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "title": "Goroutines by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{ "expr": "go_goroutines", "legendFormat": "{{instance}}" }]
    }
  ]
}